{
  "name": "pos-spartan-tech",
  "version": "0.1.0",
  "description": "Sistema de Punto de Venta de escritorio para Windows — SpArTaN Tech",
  "main": "./out/main/index.js",
  "author": "SpArTaN Tech",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "tsx scripts/check-vendor-secret.ts && pnpm build && electron-builder --win",
    "build:server": "tsx scripts/build-server.ts",
    "server:dev": "cross-env POS_ALLOW_INSECURE=1 DATABASE_URL=pglite://.data/server-pg POS_MIGRATIONS_DIR=resources/migrations-pg POS_STATIC_DIR=out/renderer POS_DATA_DIR=.data/server tsx src/server/index.ts",
    "check:schema": "tsx scripts/check-schema-parity.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "db:studio": "drizzle-kit studio",
    "migrate:sqlite-to-pg": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/sqlite-to-postgres.ts",
    "verify:backend": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-backend.ts",
    "verify:backend:pg": "cross-env DATABASE_URL=pglite://memory ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-backend.ts",
    "license:gen": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/gen-license.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-store": "^11.0.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "node-thermal-printer": "^4.6.1",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.33.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^1.41.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "zustand": "^5.0.15"
  }
}
