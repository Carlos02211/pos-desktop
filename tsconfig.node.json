{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "drizzle.config.ts",
    "drizzle.config.pg.ts",
    "tsup.config.ts",
    "src/main/**/*",
    "src/server/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "scripts/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node", "node"],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@main/*": ["src/main/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
