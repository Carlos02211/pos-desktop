# ─────────────────────────────────────────────────────────────────────
# Servidor POS SpArTaN Tech — Fase 2. Copia a `.env` y ajusta.
# ─────────────────────────────────────────────────────────────────────

# Puerto LAN (el spec de Fase 2 usa 3000). Abre este puerto en el firewall.
PORT=3000
HOST=0.0.0.0

# PostgreSQL. Si se deja vacío, el servidor usa SQLite (POS_DB_PATH).
DATABASE_URL=postgres://pos:pos@localhost:5432/pos

# Carpeta de datos (base SQLite, uploads, respaldos). Ruta absoluta recomendada.
POS_DATA_DIR=./data

# Orígenes permitidos para CORS y Socket.io (coma-separados).
# Sólo hace falta si las tabletas cargan la SPA desde OTRO origen.
# Si la SPA se sirve desde este mismo servidor, puede quedar vacío.
# POS_ALLOWED_ORIGINS=http://192.168.1.10:3000

# Secreto del generador de licencias — debe ser el MISMO que usás con `pnpm license:gen`.
# Generalo una vez con `openssl rand -base64 32`, guardalo en un gestor de contraseñas y
# NUNCA lo commitees. Sin este valor (o con el de ejemplo) el servidor no arranca.
POS_VENDOR_SECRET=CAMBIAR-genera-el-tuyo-con-openssl-rand--base64-32

# Avanzado (normalmente no hace falta tocarlos):
# POS_STATIC_DIR=./public
# POS_MIGRATIONS_DIR=./migrations-pg
# POS_DB_PATH=./data/pos.db
# POS_BACKUP_DIR=./data/backups
# POS_UPLOADS_DIR=./data/uploads
