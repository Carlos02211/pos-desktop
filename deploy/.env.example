# ─────────────────────────────────────────────────────────────────────
# Servidor POS SpArTaN Tech — Fase 2. Copia a `.env` y ajusta.
# ─────────────────────────────────────────────────────────────────────

# Puerto LAN (el spec de Fase 2 usa 3000). Abre este puerto en el firewall.
PORT=3000
HOST=0.0.0.0

# PostgreSQL — OBLIGATORIO en Fase 2 (multicajero). El servidor no arranca sin esto
# (SQLite es mono-cliente; ver auditoría §C5). Usá una instancia real, no `pglite://`.
DATABASE_URL=postgres://pos:pos@localhost:5432/pos

# Carpeta de datos (uploads, respaldos, config). Ruta absoluta recomendada.
POS_DATA_DIR=./data

# Contraseña del usuario "admin" que se crea en el PRIMER arranque (mínimo 8 caracteres).
# Si se deja vacío, el servidor genera una al azar y la imprime UNA sola vez en el log.
# No tiene efecto si ya existen usuarios en la base.
# POS_ADMIN_PASSWORD=

# Secreto para firmar los JWT de sesión (mínimo 32 caracteres, `openssl rand -hex 32`).
# Opcional: si se omite, el servidor genera uno y lo guarda en POS_DATA_DIR. Definirlo
# aquí evita depender de que esa carpeta persista y sobrevive a un pos-config.json corrupto.
# JWT_SECRET=

# Orígenes permitidos para CORS y Socket.io (coma-separados).
# Vacío = sólo mismo origen (las tabletas cargan la SPA de este servidor) — lo normal.
# Ponelo sólo si la SPA se sirve desde OTRO host/puerto.
# POS_ALLOWED_ORIGINS=http://192.168.1.10:3000

# HTTPS (recomendado si las tabletas van por WiFi). Rutas a los PEM; si se dejan
# vacías el servidor habla HTTP plano. Generá el certificado con mkcert:
#   mkcert -install && mkcert 192.168.1.10 pos.local
# e importá la CA de mkcert en cada tableta.
# POS_TLS_KEY=./certs/server-key.pem
# POS_TLS_CERT=./certs/server-cert.pem

# Sólo para pruebas locales: omite las validaciones de arranque (DATABASE_URL, secreto)
# y siembra el cajero de prueba. NUNCA en la PC del cliente.
# POS_ALLOW_INSECURE=1

# Avanzado (normalmente no hace falta tocarlos):
# POS_STATIC_DIR=./public
# POS_MIGRATIONS_DIR=./migrations-pg
# POS_DB_PATH=./data/pos.db
# POS_BACKUP_DIR=./data/backups
# POS_UPLOADS_DIR=./data/uploads
